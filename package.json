{
  "name": "malik-pos",
  "version": "1.0.0",
  "private": false,
  "description": "Free and open-source Malik POS desktop point-of-sale and kitchen recipe management system",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win nsis --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.findupto.malikpos",
    "productName": "Malik POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Malik-POS-Setup-${version}.${ext}",
      "legalCopyright": "Copyright © 2026 Aamir Malik",
      "legalTrademarks": "Malik POS"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "copyright": "Copyright © 2026 Aamir Malik"
  },
  "author": "Aamir Malik",
  "license": "MIT",
  "homepage": "https://github.com/findupto/Malik-POS-for-Computer"
}
